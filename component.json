{
  "version": 1,
  "name": "text-ui",
  "kind": "library",
  "origin": {
    "repository": "https://github.com/roolrz/HypeR",
    "commit": "8d42d047058a2b58a291803700e86487fb723f7a"
  },
  "sources": {
    "Cargo.toml": "lib/text-ui/Cargo.toml",
    "component.mk": "lib/text-ui/component.mk",
    "shared/Cargo.toml": "lib/text-ui/shared/Cargo.toml",
    "shared/src/lib.rs": "lib/text-ui/shared/src/lib.rs",
    "src/keys.rs": "lib/text-ui/src/keys.rs",
    "src/lib.rs": "lib/text-ui/src/lib.rs",
    "src/screen.rs": "lib/text-ui/src/screen.rs",
    "src/session.rs": "lib/text-ui/src/session.rs",
    "tests/keys-display.rs": "lib/text-ui/tests/keys-display.rs"
  },
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "mounts": {
    "": "lib/text-ui"
  },
  "packages": [
    "hyper-text-ui",
    "hyper-text-ui-shared"
  ],
  "tests": [
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-text-ui"
    ]
  ],
  "cargo_context": {
    "Cargo.toml": {
      "workspace": null,
      "membership": "../../app",
      "dependency_paths": {
        "/dependencies/hyper-terminal": "lib/terminal"
      },
      "inherited_dependencies": {
        "/dependencies/hyper-os": {
          "workspace": true
        },
        "/dependencies/hyper-terminal": {
          "workspace": true
        }
      }
    },
    "shared/Cargo.toml": {
      "workspace": null,
      "membership": "../../../app",
      "dependency_paths": {
        "/dependencies/implementation": "lib/text-ui",
        "/dependencies/hyper-rust-std": "stdlib/rust-std"
      },
      "inherited_dependencies": {
        "/dependencies/hyper-rust-std": {
          "workspace": true
        }
      }
    }
  }
}
